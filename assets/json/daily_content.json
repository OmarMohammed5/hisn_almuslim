{
  "ayah": [
    {
      "content": "إِنَّ مَعَ الْعُسْرِ يُسْرًا",
      "source": "سورة الشرح • آية 6"
    },
    {
      "content": "فَإِنَّ مَعَ الْعُسْرِ يُسْرًا",
      "source": "سورة الشرح • آية 5"
    },
    {
      "content": "وَقُل رَّبِّ زِدْنِي عِلْمًا",
      "source": "سورة طه • آية 114"
    },
    {
      "content": "وَمَن يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ",
      "source": "سورة الطلاق • آية 3"
    },
    {
      "content": "أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ",
      "source": "سورة الرعد • آية 28"
    },
    {
      "content": "إِنَّ اللَّهَ مَعَ الصَّابِرِينَ",
      "source": "سورة البقرة • آية 153"
    },
    {
      "content": "وَقُلْ رَبِّ اغْفِرْ وَارْحَمْ وَأَنتَ خَيْرُ الرَّاحِمِينَ",
      "source": "سورة المؤمنون • آية 118"
    }
  ],
  "hadith": [
    {
      "content": "إِنَّمَا الأَعْمَالُ بِالنِّيَّاتِ",
      "source": "رواه البخاري ومسلم"
    },
    {
      "content": "مَنْ لَا يَرْحَمْ لَا يُرْحَمْ",
      "source": "رواه البخاري ومسلم"
    },
    {
      "content": "خَيْرُكُمْ مَنْ تَعَلَّمَ الْقُرْآنَ وَعَلَّمَهُ",
      "source": "رواه البخاري"
    },
    {
      "content": "مَنْ كَانَ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ فَلْيَقُلْ خَيْرًا أَوْ لِيَصْمُتْ",
      "source": "رواه البخاري ومسلم"
    },
    {
      "content": "لَا ضَرَرَ وَلَا ضِرَارَ",
      "source": "رواه ابن ماجه"
    }
  ],
  "dhikr": [
    {
      "content": "سُبْحَانَ اللَّهِ وَبِحَمْدِهِ",
      "source": "ذكر"
    },
    {
      "content": "سُبْحَانَ اللَّهِ وَالْحَمْدُ لِلَّهِ",
      "source": "ذكر"
    },
    {
      "content": "لَا إِلَهَ إِلَّا اللَّهُ",
      "source": "ذكر"
    },
    {
      "content": "اللَّهُ أَكْبَرُ",
      "source": "ذكر"
    },
    {
      "content": "أَسْتَغْفِرُ اللَّهَ",
      "source": "ذكر"
    }
  ],
  "dua": [
    {
      "content": "رَبِّ اشْرَحْ لِي صَدْرِي",
      "source": "سورة طه • آية 25"
    },
    {
      "content": "رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً",
      "source": "سورة البقرة • آية 201"
    },
    {
      "content": "رَبِّ زِدْنِي عِلْمًا",
      "source": "سورة طه • آية 114"
    },
    {
      "content": "رَبَّنَا اغْفِرْ لَنَا وَلِوَالِدِينَا وَلِلْمُؤْمِنِينَ",
      "source": "دعاء"
    },
    {
      "content": "رَبِّ اغْفِرْ لِي وَلِوَالِدَيَّ",
      "source": "دعاء"
    }
  ]
